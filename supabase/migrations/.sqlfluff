[sqlfluff]
# Scoped to this folder so it does not affect any other .sql in the repo.
dialect = postgres
templater = raw
max_line_length = 200
# The consolidated dumps (all_migrations_combined.sql) are skipped rather than
# parsed in full, to keep the language server responsive.
large_file_skip_byte_limit = 100000

[sqlfluff:rules]
# These migrations are hand-written Postgres DDL full of plpgsql
# (DO $$ ... $$ blocks, CREATE FUNCTION bodies, triggers). Layout and
# capitalisation rules fire constantly on that and bury the real findings.
# Starting point - tune by running: python -m sqlfluff lint <file>
exclude_rules = L003,L009,L010,L014,L016,L029,RF01,RF02,RF03