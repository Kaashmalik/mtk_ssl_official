+import type { Metadata } from "next"
+import Link from "next/link"
+import { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from "@mtk/ui/components/ui/card"
+import { Button } from "@mtk/ui/components/ui/button"
+import { Badge } from "@mtk/ui/components/ui/badge"
+import { Check, Crown, X } from "lucide-react"
+import { PLAN_LIMITS, PLAN_PRICES, type PlanKey } from "@mtk/database/lib/plan-limits"
+
+export const metadata: Metadata = {
+  title: "Pricing — Shakir Super League Platform",
+  description:
+    "League management, live scoring, streaming and fan engagement for cricket leagues. Plans from free to enterprise, priced per league in PKR.",
+}
+
+/**
+ * Public pricing page. Plan data comes from the single source of truth —
+ * `@mtk/database/lib/plan-limits` — the same constants the billing screen
+ * and the plan guards enforce, so this page can never drift from what a
+ * league actually gets. Feature copy mirrors the billing screen
+ * (dashboard/settings/billing) on purpose.
+ */
+const PLAN_COPY: Record<
+  PlanKey,
+  { name: string; description: string; period: string; features: string[]; popular?: boolean }
+> = {
+  free: {
+    name: "Free",
+    description: "Perfect for small local leagues",
+    period: "forever",
+    features: ["Basic scoring", "Points table", "Public league page"],
+  },
+  starter: {
+    name: "Starter",
+    description: "For growing leagues",
+    period: "per league",
+    features: [
+      "Advanced scoring",
+      "Player statistics",
+      "Custom branding",
+      "Payment collection",
+    ],
+  },
+  pro: {
+    name: "Pro",
+    description: "For professional leagues",
+    period: "per league",
+    features: [
+      "Fantasy cricket (roadmap)",
+      "Priority support",
+      "Advanced analytics",
+      "API access",
+    ],
+    popular: true,
+  },
+  enterprise: {
+    name: "Enterprise",
+    description: "For major tournaments & boards",
+    period: "per league",
+    features: [
+      "Everything in Pro",
+      "Dedicated support",
+      "SLA guarantee",
+      "Custom integrations",
+      "Training & onboarding",
+    ],
+  },
+}
+
+const PLAN_ORDER: PlanKey[] = ["free", "starter", "pro", "enterprise"]
+
+function formatLimit(value: number): string {
+  return value === Infinity ? "Unlimited" : value.toLocaleString()
+}
+
+export default function PricingPage() {
+  return (
+    <div className="space-y-10 max-w-6xl mx-auto px-4 py-10">
+      <div className="text-center space-y-3">
+        <h1 className="text-4xl font-bold tracking-tight">Pricing</h1>
+        <p className="text-muted-foreground max-w-2xl mx-auto">
+          One price per league — live scoring, fixtures, points tables, fan
+          predictions and notifications included in every plan. Pay with
+          JazzCash, Easypaisa, bank transfer or card.
+        </p>
+      </div>
+
+      <div className="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
+        {PLAN_ORDER.map((key) => {
+          const copy = PLAN_COPY[key]
+          const limits = PLAN_LIMITS[key]
+          return (
+            <Card key={key} className={copy.popular ? "border-primary shadow-md" : undefined}>
+              <CardHeader>
+                <div className="flex items-center justify-between">
+                  <CardTitle className="flex items-center gap-2">
+                    {key === "enterprise" && <Crown className="h-5 w-5 text-primary" />}
+                    {copy.name}
+                  </CardTitle>
+                  {copy.popular && <Badge>Most popular</Badge>}
+                </div>
+                <CardDescription>{copy.description}</CardDescription>
+              </CardHeader>
+              <CardContent className="space-y-4">
+                <div>
+                  <span className="text-3xl font-bold">
+                    Rs {PLAN_PRICES[key].toLocaleString()}
+                  </span>
+                  <span className="text-muted-foreground text-sm"> / {copy.period}</span>
+                </div>
+                <ul className="space-y-2 text-sm">
+                  <li className="flex gap-2">
+                    <Check className="h-4 w-4 mt-0.5 shrink-0 text-primary" />
+                    Up to {formatLimit(limits.maxTeams)} teams
+                  </li>
+                  <li className="flex gap-2">
+                    <Check className="h-4 w-4 mt-0.5 shrink-0 text-primary" />
+                    Up to {formatLimit(limits.maxPlayers)} players
+                  </li>
+                  {copy.features.map((feature) => (
+                    <li key={feature} className="flex gap-2">
+                      <Check className="h-4 w-4 mt-0.5 shrink-0 text-primary" />
+                      {feature}
+                    </li>
+                  ))}
+                  <li className="flex gap-2">
+                    {limits.liveStreaming ? (
+                      <Check className="h-4 w-4 mt-0.5 shrink-0 text-primary" />
+                    ) : (
+                      <X className="h-4 w-4 mt-0.5 shrink-0 text-muted-foreground" />
+                    )}
+                    <span className={limits.liveStreaming ? undefined : "text-muted-foreground"}>
+                      Live streaming
+                    </span>
+                  </li>
+                  <li className="flex gap-2">
+                    {limits.whiteLabel ? (
+                      <Check className="h-4 w-4 mt-0.5 shrink-0 text-primary" />
+                    ) : (
+                      <X className="h-4 w-4 mt-0.5 shrink-0 text-muted-foreground" />
+                    )}
+                    <span className={limits.whiteLabel ? undefined : "text-muted-foreground"}>
+                      White-label branding
+                    </span>
+                  </li>
+                  <li className="flex gap-2">
+                    {limits.customDomain ? (
+                      <Check className="h-4 w-4 mt-0.5 shrink-0 text-primary" />
+                    ) : (
+                      <X className="h-4 w-4 mt-0.5 shrink-0 text-muted-foreground" />
+                    )}
+                    <span className={limits.customDomain ? undefined : "text-muted-foreground"}>
+                      Custom domain
+                    </span>
+                  </li>
+                </ul>
+              </CardContent>
+              <CardFooter>
+                <Button asChild className="w-full" variant={copy.popular ? "default" : "outline"}>
+                  <Link href="/sign-up">
+                    {key === "free" ? "Start free" : `Choose ${copy.name}`}
+                  </Link>
+                </Button>
+              </CardFooter>
+            </Card>
+          )
+        })}
+      </div>
+
+      <p className="text-center text-sm text-muted-foreground">
+        Running a tournament or a board with several leagues?{" "}
+        <Link href="/sign-up" className="underline underline-offset-4 hover:text-foreground">
+          Talk to us about Enterprise
+        </Link>{" "}
+        — seasonal and per-tournament options are available.
+      </p>
+    </div>
+  )
+}
