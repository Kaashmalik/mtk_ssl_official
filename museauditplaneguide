@@ -0,0 +1,146 @@
+import { describe, it, expect } from "vitest";
+import { readFileSync, readdirSync, statSync } from "node:fs";
+import { join, extname, relative } from "node:path";
+
+/**
+ * Security guard: API route handlers that touch the database directly.
+ *
+ * Companion to `no-unscoped-queries.test.ts`, which guards server actions.
+ * Route handlers under `app/api/` were outside that guard's scope; this test
+ * closes the gap. A route may use `db` directly ONLY if it is allowlisted
+ * below with its tenant-scoping justification, verified by review:
+ *
+ *   - billing/stripe/checkout — authenticated; resolves the caller's own
+ *     tenant via `getMyTenant()` and checks `tenant.ownerId` against the
+ *     authenticated actor before any write.
+ *   - dns/verify — authenticated; `canManageTenantDomain(userId, tenantId)`
+ *     must pass before any tenant row is read or updated.
+ *   - matches/[matchId]/ai-summary — public; resolves the tenant from the
+ *     request host (`getPublicTenantContext`), loads the match through the
+ *     publication gate (`readPublishedMatch`), and predicates every query
+ *     on that tenantId.
+ *   - scorecards/[matchId]/pdf — public; same host-tenant resolution and
+ *     publication gate as ai-summary. Cross-tenant matchIds return 404.
+ *   - health — liveness probe only; `db.select(...).limit(1)` existence
+ *     ping against `users`, returns no tenant data.
+ *   - og/match/[id] — public OG image; resolves the tenant from the
+ *     request host (`getPublicTenantContext`), fails closed to a
+ *     placeholder image, and predicates every query on that tenantId.
+ *
+ * Any NEW route that calls `db.select/insert/update/delete`, `db.query.*`
+ * or `db.transaction` fails this test until it is reviewed and added here —
+ * or, preferably, moved to a tenant-scoped reader/writer in `lib/`.
+ */
+
+const API_DIR = join(__dirname, "../app/api");
+
+/** Route files (path relative to `app/api/`) reviewed and allowed to use db. */
+const ALLOWLIST = new Set([
+  "billing/stripe/checkout/route.ts",
+  "dns/verify/route.ts",
+  "health/route.ts",
+  "matches/[matchId]/ai-summary/route.ts",
+  "og/match/[id]/route.tsx",
+  "scorecards/[matchId]/pdf/route.ts",
+]);
+
+interface Finding {
+  file: string;
+  line: number;
+  match: string;
+}
+
+function findRouteFiles(dir: string): string[] {
+  const results: string[] = [];
+  for (const entry of readdirSync(dir)) {
+    const full = join(dir, entry);
+    if (statSync(full).isDirectory()) {
+      results.push(...findRouteFiles(full));
+    } else if (entry === "route.ts" || entry === "route.tsx") {
+      results.push(full);
+    } else if (extname(entry) === ".ts" && entry.endsWith(".route.ts")) {
+      results.push(full);
+    }
+  }
+  return results;
+}
+
+/**
+ * Regex scanner in the same spirit as the actions guard, extended with
+ * `db.query.` and `db.transaction(` so a route cannot bypass the review by
+ * switching access style. Good enough for a CI gate; not a full parser.
+ */
+function scanForDirectDbUse(filePath: string): Finding[] {
+  const content = readFileSync(filePath, "utf8");
+  const lines = content.split("\n");
+  const findings: Finding[] = [];
+  const pattern = /\bdb\.(select|update|delete|insert|transaction)\s*\(|\bdb\.query\./g;
+
+  for (let i = 0; i < lines.length; i++) {
+    const line = lines[i];
+    let match: RegExpExecArray | null;
+    while ((match = pattern.exec(line)) !== null) {
+      findings.push({ file: filePath, line: i + 1, match: match[0] });
+    }
+  }
+  return findings;
+}
+
+describe("Tenant Isolation: No Unreviewed Direct DB Use in API Routes", () => {
+  const files = findRouteFiles(API_DIR);
+
+  it("api directory exists and has route files", () => {
+    expect(files.length).toBeGreaterThan(0);
+  });
+
+  it.each(
+    files.map((f) => ({ file: f, rel: relative(API_DIR, f).split("\\").join("/") }))
+  )(
+    "$rel: direct db use is allowlisted (reviewed tenant scoping)",
+    ({ file, rel }) => {
+      const findings = scanForDirectDbUse(file).filter((finding) => {
+        const lineContent = readFileSync(finding.file, "utf8").split("\n")[finding.line - 1];
+        return !lineContent.trim().startsWith("//") && !lineContent.trim().startsWith("*");
+      });
+
+      if (findings.length === 0) {
+        return; // No direct db use — pass
+      }
+
+      expect(
+        ALLOWLIST.has(rel),
+        `Direct db use found in api/${rel}:${findings.map((f) => f.line).join(",")} ` +
+          `(${[...new Set(findings.map((f) => f.match))].join(", ")}). ` +
+          `Route handlers must resolve a tenant context and scope every query to it. ` +
+          `Prefer a tenant-scoped reader/writer in lib/; if direct db use is genuinely ` +
+          `required, add the route to the allowlist in this test WITH its scoping ` +
+          `justification, in the same PR.`
+      ).toBe(true);
+    }
+  );
+
+  it("every allowlisted route still exists (allowlist cannot rot)", () => {
+    const rels = new Set(files.map((f) => relative(API_DIR, f).split("\\").join("/")));
+    for (const allowed of ALLOWLIST) {
+      expect(rels.has(allowed), `Allowlisted route api/${allowed} no longer exists — remove it from the allowlist`).toBe(true);
+    }
+  });
+
+  it("allowlisted tenant routes keep their scoping anchors", () => {
+    // If a refactor removes the scoping mechanism from an allowlisted route,
+    // the allowlist justification is void — fail loudly instead of silently.
+    const anchors: Record<string, string[]> = {
+      "billing/stripe/checkout/route.ts": ["getMyTenant", "ownerId"],
+      "dns/verify/route.ts": ["canManageTenantDomain"],
+      "matches/[matchId]/ai-summary/route.ts": ["getPublicTenantContext", "readPublishedMatch"],
+      "og/match/[id]/route.tsx": ["getPublicTenantContext"],
+      "scorecards/[matchId]/pdf/route.ts": ["getPublicTenantContext", "readPublishedMatch"],
+    };
+    for (const [rel, needles] of Object.entries(anchors)) {
+      const content = readFileSync(join(API_DIR, rel), "utf8");
+      for (const needle of needles) {
+        expect(content, `api/${rel} lost its tenant-scoping anchor "${needle}"`).toContain(needle);
+      }
+    }
+  });
+});
