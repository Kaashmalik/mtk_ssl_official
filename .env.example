# ============================================
# SSL Shakir Super League - Environment Configuration
# Copy this file to .env.prod and fill in your actual values
# ============================================

# ============================================
# Core Infrastructure (Required)
# ============================================

# ============================================
# Database (Choose ONE option)
# ============================================

# Option A: Self-hosted PostgreSQL (Docker)
POSTGRES_USER=ssl
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=ssl_prod
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Option B: Supabase (Recommended - https://supabase.com)
# Get connection string from: Project Settings -> Database -> Connection string -> URI
# Use "Session mode" for application, "Transaction mode" for connection pooling
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ... (from Project Settings -> API -> service_role key)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ... (from Project Settings -> API -> anon/public key)
# DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# Redis Cache/Session Store
# REDIS_URL is the canonical Redis connection string used across services.
REDIS_URL=redis://redis:6379

# Kafka Message Broker
KAFKA_BROKERS=kafka:29092

# ClickHouse Analytics Database
CLICKHOUSE_USER=ssl
CLICKHOUSE_PASSWORD=your_secure_clickhouse_password_here
CLICKHOUSE_URL=http://clickhouse:8123

# ============================================
# Authentication (Clerk) - Required
# Get from: https://dashboard.clerk.com
# ============================================
CLERK_SECRET_KEY=sk_live_your_clerk_secret_key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_your_clerk_publishable_key

# Super Admin email (fallback role escalation for initial bootstrap)
SUPER_ADMIN_EMAIL=your-email@maliktech.dev

# ============================================
# Impersonation Security - Required for admin
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ============================================
IMPERSONATION_TOKEN_SECRET=your_64_char_random_string_here_MINIMUM

# ============================================
# Payments - Required for transactions
# ============================================

# Stripe (International Payments)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# JazzCash (Pakistan Local Payments)
# Contact JazzCash Business for credentials
JAZZCASH_MERCHANT_ID=your_jazzcash_merchant_id
JAZZCASH_PASSWORD=your_jazzcash_password
JAZZCASH_INTEGRITY_SALT=your_jazzcash_integrity_salt
# Canonical base URL of the JazzCash merchant form (sandbox for testing).
JAZZCASH_BASE_URL=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform
# Where JazzCash redirects the payer after payment (must be public HTTPS).
JAZZCASH_RETURN_URL=https://ssl.yourdomain.com/payment/callback

# Manual Bank & Wallet Details (Shown in Billing / Upgrade Modals) - SINGLE canonical block
NEXT_PUBLIC_PAYMENT_BANK_NAME="Meezan Bank"
NEXT_PUBLIC_PAYMENT_BANK_TITLE="MUHAMMAD KASHIF"
NEXT_PUBLIC_PAYMENT_BANK_ACCOUNT="11330109676650"
NEXT_PUBLIC_PAYMENT_BANK_IBAN="PK26MEZN0011330109676650"
NEXT_PUBLIC_PAYMENT_BANK_BRANCH="BHUBTIAN BRANCH, LAHORE"
NEXT_PUBLIC_PAYMENT_JAZZCASH_NAME="Muhammad Kashif"
NEXT_PUBLIC_PAYMENT_JAZZCASH_NUMBER="03020718182"
NEXT_PUBLIC_PAYMENT_EASYPAISA_NAME="Muhammad Kashif"
NEXT_PUBLIC_PAYMENT_EASYPAISA_NUMBER="03020718182"
NEXT_PUBLIC_PAYMENT_RAAST_ID="03020718182"

# ============================================
# AI Commentary (OpenAI) - Required for live commentary
# Get from: https://platform.openai.com/api-keys
# ============================================
# Required in production (ai-commentary-service refuses to boot without it).
OPENAI_API_KEY=sk-your_openai_api_key
# Model used for commentary generation (default: gpt-4o).
#
# Choosing one — commentary is short (80-150 tokens), generated per ball, and
# latency-sensitive: it appears while the crowd is watching. At realistic
# volumes (a T20 is ~240 balls; even a busy league is thousands of calls/month)
# cost is negligible at every tier below, so optimise for quality and
# multilingual output, not price.
#
#   gpt-5.4-mini   recommended balance — strong quality, low latency
#                  ($0.75/M in, $4.50/M out, 400k ctx)
#   gpt-5.4-nano   cheapest ($0.20/M in, $1.25/M out). Only worth it for bulk
#                  backfill of historical commentary. Weakest in low-resource
#                  languages (Urdu/Punjabi/Pashto/Sindhi) — avoid for these.
#   gpt-4o-mini    safest widely-available option, ~4x cheaper than gpt-4o
#   gpt-4o         current default; leave in place unless you have verified
#                  access to the model you want to switch to (availability
#                  varies by org tier)
#
# The request body adapts automatically: gpt-5/o-series models get
# `max_completion_tokens` and no `temperature` (they reject it); all others get
# `max_tokens` + `temperature`. Switching this value needs no code change.
#
# Before switching to a gpt-5 family model, confirm your org has API access —
# an inaccessible model surfaces as a 404/400 that falls back to templates and
# silently degrades live commentary.
OPENAI_MODEL=gpt-4o
# Set to "true" to use deterministic mock commentary (local/dev only).
OPENAI_MOCK=false

# ============================================
# Notifications - Optional but recommended
# ============================================

# Firebase Cloud Messaging (Push Notifications)
# Create service account in Firebase Console -> Project Settings -> Service Accounts
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"..."}

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM=noreply@yourdomain.com

# Twilio SMS (Optional)
TWILIO_SID=your_twilio_account_sid
TWILIO_TOKEN=your_twilio_auth_token
TWILIO_PHONE=+1234567890

# ============================================
# Error Tracking & Monitoring - Recommended
# ============================================

# Sentry (Error Tracking)
# Get from: https://sentry.io/settings/your-org/projects/
# NOTE: instrumentation.ts reads SENTRY_DSN (NOT NEXT_PUBLIC_SENTRY_DSN).
# The DSN is safe to expose but we keep it server-side by convention.
SENTRY_DSN=https://your_public_key@o123456.ingest.sentry.io/your_project_id
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=ssl-web
# Fraction of transactions sampled for performance monitoring (0.0 - 1.0).
SENTRY_TRACES_SAMPLE_RATE=0.1
# Optional: explicit release identifier (defaults to commit SHA in CI).
SENTRY_RELEASE=
# Logical deploy env for Sentry (staging vs production). Prefer over NODE_ENV alone.
APP_ENV=development
# Optional override if APP_ENV differs per process.
# SENTRY_ENVIRONMENT=staging
# Auth token for source-map upload during build. Upload runs ONLY when
# CI=true or SENTRY_UPLOAD=1 (avoids local builds failing on wrong org/project).
SENTRY_AUTH_TOKEN=
# Set to 1 to force Sentry webpack upload outside CI.
# SENTRY_UPLOAD=0

# ============================================
# Observability - Structured Logging
# ============================================
# Per-app tag attached to every structured log line.
SERVICE_NAME=web
# Lowest level that will be emitted: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ============================================
# White-Label Automation - DNS / SSL / Cron
# ============================================
# Shared secret Vercel Cron sends when invoking /api/cron/* routes.
# Generate with: openssl rand -hex 32
CRON_SECRET=replace_with_random_64_char_hex_string

# Base URL of the NestJS API service (RETIRED / ARCHIVED).
# API_SERVICE_URL=http://localhost:4000

# Secret the SSL controller (/ssl/issue, /ssl/renew) expects.
# Defaults to CRON_SECRET if not set. Generate a separate one for prod.
SSL_ADMIN_TOKEN=

# --- ACME / Let's Encrypt ---
# "production" for real certs, anything else for staging (rate-limit-friendly).
ACME_ENVIRONMENT=staging
# Directory for the ACME account key (default: <cwd>/ssl-keys).
ACME_KEY_DIR=
# Directory for issued certificates (default: <cwd>/ssl-certs).
# MUST be a persistent, encrypted volume in production.
CERT_STORAGE_DIR=

# --- DNS Provider ---
# "cloudflare" for API-driven record management, empty for manual (UI shows
# instructions the tenant must add by hand).
DNS_PROVIDER=
# Cloudflare API token with Zone:DNS:Edit permission (only if DNS_PROVIDER=cloudflare).
CLOUDFLARE_API_TOKEN=
# Optional: pin a specific Cloudflare zone id (otherwise resolved by name).
CLOUDFLARE_ZONE_ID=

# ============================================
# API Infrastructure - Required for production
# ============================================

# Shared bearer token for internal API (/api cron, internal WS auth).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
API_AUTH_TOKEN=replace_with_random_token

# REMOVED: SCORING_GATEWAY_TOKEN
#
# The /scoring WebSocket namespace is now READ/BROADCAST ONLY. It previously
# exposed `record-ball` / `undo-ball` handlers that called the scoring service
# directly, bypassing the HTTP controller's auth and tenant checks — and nothing
# ever emitted those events from any client, so it was an unreachable write
# surface guarded more weakly than the real one.
#
# All scoring writes now flow through one path:
#   web server action -> POST /scoring/* (SCORING_SERVICE_TOKEN + x-tenant-id)
#                     -> ScoringService
#
# Browsers connect to /scoring anonymously and receive read-only broadcasts
# (score-update / commentary-update / match-state / fan-reaction). They must
# never hold a scoring write token.
# NEXT_PUBLIC_SCORING_WS_TOKEN=

# Internal token the web app sends when proxying writes to scoring-service
# (sent as the x-scoring-service-token header). Scoring-service fails closed in
# production when this is unset. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SCORING_SERVICE_TOKEN=replace_with_random_scoring_service_token
#
# Every scoring write additionally carries an `x-tenant-id` header, set
# automatically by apps/web from the caller's session (getMyTenant). It is not a
# separate secret and does not need configuring — scoring-service uses it to
# scope each query, because it runs as service_role and therefore bypasses RLS.
# Keep the service off the public internet: the token is the real trust boundary.

# HMAC key for hashing one-time passcodes before they are stored in
# verification_tokens. Rotating it invalidates all outstanding OTPs.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
OTP_HMAC_SECRET=replace_with_random_otp_hmac_secret

# Absolute URL of the web app. The admin app uses it to hand off impersonation
# sessions to /impersonation/callback on the web app. Invite emails embed links
# to /accept-invite on this host.
WEB_APP_URL=https://ssl.mtkcodex.site

# ── Public-page tenant resolution (development only) ──────────────────────────
# Public pages (/matches/[id], /matches/[id]/live, /tournaments/[id],
# /api/og/match/[id]) are unauthenticated but TENANT-SCOPED: a match is only
# visible on its own tenant's subdomain or custom domain. Resolution order is
#   1. tenants.customDomain === request host
#   2. tenants.slug === first subdomain label (ssl.mtkcodex.site -> "ssl")
#   3. this variable (non-production only)
# Because `http://localhost:3001` carries no subdomain, set this so public pages
# resolve a tenant in local dev, e.g.
#   PUBLIC_TENANT_SLUG=ssl
# then use http://ssl.localhost:3001/matches/<id> (works without this variable).
# IGNORED when NODE_ENV=production, so it cannot weaken tenant isolation in a
# real deployment. Unset + non-subdomain host => public pages 404 (fail closed).
PUBLIC_TENANT_SLUG=

# notification-service HTTP port. Must differ from streaming-service (5005/5008).
NOTIFICATION_SERVICE_PORT=4008

# Multi-channel OTP delivery. When a provider key is missing the OTP service
# falls back to mock mode and logs the code server-side (development only).
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=SSL <onboarding@ssl.mtkcodex.site>
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Base URL of Nest scoring-service (canonical ball-write SoT).
# Web server actions proxy recordBall/undo here. Default matches local scoring PORT.
SCORING_SERVICE_URL=http://localhost:4002

# Online Stripe / JazzCash / EasyPaisa via payment-service — keep false until merchant is live.
# Manual PK bank / JazzCash / EasyPaisa proof uploads stay in apps/web.
ONLINE_PAYMENTS_ENABLED=false

# --- Stripe Checkout (international tenants) ---
# POST /api/billing/stripe/checkout returns 501 until STRIPE_SECRET_KEY is set,
# so PK deployments are unaffected. The webhook auto-approves the matching
# subscription_request on checkout.session.completed, then issues an invoice.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # from `stripe listen` or the dashboard
# Commission/tax applied to generated invoices (percent, e.g. 5 = 5%).
INVOICE_TAX_RATE=0

# ============================================
# Media — Cloudinary (admin image/video uploads)
# ============================================
# Create an unsigned upload preset in Cloudinary Console for admin uploads,
# or switch to signed uploads for production hardening (Phase later).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_or_signed_preset

# Mobile Expo — scoring SoT base URL (same as SCORING_SERVICE_URL)
EXPO_PUBLIC_SCORING_SERVICE_URL=http://localhost:4002

# ============================================
# WebRTC Streaming - Required for live streaming
# ============================================
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=your_server_public_ip_or_domain
MEDIASOUP_MIN_PORT=10000
MEDIASOUP_MAX_PORT=10100
RTC_MIN_PORT=40000
RTC_MAX_PORT=49999

# Token producers/consumers must send on WS connect (streaming-service).
# Required in production (streaming-service refuses to boot without it).
STREAMING_ACCESS_TOKEN=replace_with_random_streaming_token

# ============================================
# Frontend Configuration (Public)
# ============================================
NEXT_PUBLIC_API_URL=https://api.ssl.mtkcodex.site
# Socket.IO base for scoring-service (namespace /scoring is appended by the client).
# Production: wss://ws.ssl.mtkcodex.site — must match scoring Nest deploy.
NEXT_PUBLIC_WS_URL=wss://ws.ssl.mtkcodex.site

# ============================================
# Rate Limiting (Upstash Redis) - Recommended for web
# ============================================
# Used by apps/web rate-limit.ts to protect API routes in production.
UPSTASH_REDIS_REST_URL=https://your-project.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# ============================================
# Node Environment
# ============================================
NODE_ENV=production

# ============================================
# Optional: Development/Local Override
# Uncomment for local development
# ============================================
# NODE_ENV=development
# NEXT_PUBLIC_API_URL=http://localhost:3000
# NEXT_PUBLIC_WS_URL=http://localhost:4002