{
  "name": "@ssl/scoring-service",
  "version": "1.0.0",
  "description": "Real-time cricket scoring microservice with WebSocket support",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/microservices": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "express": "^4.21.1",
    "@nestjs/platform-socket.io": "^11.1.0",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/websockets": "^11.1.0",
    "@mtk/database": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "kafkajs": "^2.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.0",
    "zod": "^3.24.0",
    "@sentry/node": "^9.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.0",
    "typescript": "^5.7.0"
  }
}
