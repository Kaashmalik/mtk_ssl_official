{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../",
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@mtk/database$": "<rootDir>/../../packages/database/src/index.ts",
    "^@mtk/database/(.*)$": "<rootDir>/../../packages/database/src/$1",
    "^@mtk/dns-provider$": "<rootDir>/../../packages/dns-provider/src/index.ts",
    "^@mtk/dns-provider/(.*)$": "<rootDir>/../../packages/dns-provider/src/$1"
  },
  "collectCoverageFrom": ["src/**/*.(t|j)s"],
  "coverageDirectory": "./coverage",
  "testEnvironment": "node"
}
